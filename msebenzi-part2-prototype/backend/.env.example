# Copy this file to .env and fill in your own values.
# Never commit your real .env file to GitHub.

# Server
PORT=3000

# Auth
JWT_SECRET=replace_with_a_long_random_string

# Admin (used only by PUT /api/admin/users/:id/verify to approve a
# worker's verification request — see README section 1.1)
ADMIN_TOKEN=replace_with_a_long_random_string

# Database
# Leave DATABASE_URL blank to use a local SQLite file for development.
# When you host on Render, Render will give you a Postgres connection
# string to paste here, e.g.:
# DATABASE_URL=postgres://user:password@host:5432/dbname
DATABASE_URL=

# --- Part 3 additions ---------------------------------------------------------

# How long a login lasts (default 30d)
JWT_EXPIRES_IN=30d

# Google single sign-on: the OAuth *Web application* client ID from Google Cloud Console.
# The SAME value goes into android/local.properties as google.web.client.id
GOOGLE_WEB_CLIENT_ID=

# Real-time push notifications (optional): paste the ENTIRE contents of the Firebase
# service-account JSON key here (Firebase console > Project settings > Service accounts >
# Generate new private key). Leave blank to disable push - the app falls back to polling.
FIREBASE_SERVICE_ACCOUNT_JSON=
